# Copy to .env (git-ignored). Never commit real secrets.
MODEL_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
ORCHESTRATOR_MODEL=qwen2.5:7b
CODE_MODEL=qwen2.5:7b
RESEARCH_MODEL=qwen2.5:7b
OPS_MODEL=qwen2.5:7b
JUDGE_MODEL=qwen2.5:7b
SUMMARIZER_MODEL=qwen2.5:7b

# docker-compose Postgres is published on host port 5433
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5433/jarvis
WORKSPACE_ROOT=.

# Tool credentials - injected into tool instances only, never into model context or traces
GMAIL_TOKEN=
CALENDAR_TOKEN=
