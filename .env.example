# Copy to .env (git-ignored). Never commit real secrets.

# --- model backend -------------------------------------------------------------------------
MODEL_PROVIDER=ollama                 # ollama | mock  (mock = deterministic, no live model)
OLLAMA_HOST=http://localhost:11434
# One model per role, so routing can use a cheap model and code gen a stronger one.
ORCHESTRATOR_MODEL=qwen2.5:7b
CODE_MODEL=qwen2.5:7b
RESEARCH_MODEL=qwen2.5:7b
OPS_MODEL=qwen2.5:7b
JUDGE_MODEL=qwen2.5:7b                # point at a STRONGER model than the agents where you can
SUMMARIZER_MODEL=qwen2.5:7b

# --- storage -------------------------------------------------------------------------------
# docker-compose publishes Postgres on host port 5433 so it never collides with a local install.
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5433/jarvis
TRACE_BACKEND=postgres                # postgres | memory (memory = no database needed)
# Tests never use this database: they use <name>_test (override with TEST_DATABASE_URL).

# --- harness -------------------------------------------------------------------------------
MAX_AGENT_ITERATIONS=8                # hard cap per agent loop; a non-converging model is bounded
MEMORY_TOKEN_BUDGET=3000              # summarize older turns past this many tokens of context
WORKSPACE_ROOT=.                      # the only tree read_file / code_exec may read from
DOCS_DIR=                             # notes ingested for RAG at startup (default: <repo>/docs)

# --- RAG (local, independent of the chat model) --------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- tool credentials ----------------------------------------------------------------------
# Injected into tool instances only. They never enter a prompt, a tool schema or a trace payload
# (app/tools/credentials.py); leave blank to run the calendar/email tools against fakes.
GMAIL_TOKEN=
CALENDAR_TOKEN=
